{
  "name": "reel-local-movie-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "build": "vite build",
    "start": "npm run build && vite preview --host localhost --port 5173 --strictPort",
    "preview": "vite preview --host localhost --port 5173 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "configure:cors": "powershell -NoProfile -File scripts/configure-cors.ps1"
  },
  "dependencies": { "events": "3.3.0", "pouchdb-browser": "9.0.0" },
  "overrides": { "uuid": "11.1.1" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "pouchdb-adapter-memory": "9.0.0",
    "pouchdb-core": "9.0.0",
    "vite": "8.3.0"
  }
}
